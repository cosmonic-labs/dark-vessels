package darkvessel:dark-vessels;

world sar-processor {
  import wasmcloud:messaging/consumer@0.2.0;
  export wasmcloud:messaging/handler@0.2.0;
  // GPU-capable detection trigger: the async P3 HTTP export. The sync
  // messaging handler cannot block on wasi:webgpu's `async func` imports
  // (wasmtime rejects guest waits inside a sync-lifted export), so GPU
  // requests arrive here.
  export wasi:http/handler@0.3.0;
}

world sar-processor-gpu {
  import wasi:webgpu/webgpu@0.3.0-rc.2;
  import wasmcloud:messaging/consumer@0.2.0;
  export wasmcloud:messaging/handler@0.2.0;
  export wasi:http/handler@0.3.0;
}
